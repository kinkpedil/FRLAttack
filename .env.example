# Salin ke .env.local lalu isi dari dashboard Supabase (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Rahasia: jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Alamat situs untuk redirect login. Kosongkan di lokal.
NEXT_PUBLIC_SITE_URL=
